{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!test/fixtures/"] },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": { "noThisInStatic": "off" },
      "style": { "noDescendingSpecificity": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      "includes": ["src/app/roots-app.ts", "src/storage/file-location.ts"],
      "linter": { "rules": { "complexity": { "useOptionalChain": "off" } } }
    }
  ]
}
